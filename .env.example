# Copy to .env (never commit it).
# Local roundup dev server, https://staging.carolinamarketroundup.com or https://www.carolinamarketroundup.com
ROUNDUP_URL=http://localhost:5173
# Must match the roundup's LEADS_API_KEY (.dev.vars locally, a Cloudflare secret on staging/production).
LEADS_API_KEY=dev-only-leads-key
